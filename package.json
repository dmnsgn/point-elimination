    "point",
    "points",
    "sample-elimination",
    "poisson-disk",
    "poisson-disc",
    "blue-noise",
    "sampling",
    "point-cloud",
    "progressive",
    "adaptive",
    "typed-array"
  ],
  "homepage": "https://github.com/dmnsgn/point-elimination",
  "bugs": "https://github.com/dmnsgn/point-elimination/issues",
